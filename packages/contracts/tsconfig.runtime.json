{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist/runtime-cjs",
    "rootDir": "src",
    "ignoreDeprecations": "6.0",
    "verbatimModuleSyntax": false
  },
  "include": [
    "src/projects.ts",
    "src/discovery-follow-ups.ts",
    "src/markdown-templates.ts",
    "src/customer-mail.ts",
    "src/active-project-queue.ts",
    "src/project-preparation-status.ts",
    "src/discovery.ts",
    "src/decision-portfolio.ts",
    "src/customer-response.ts",
    "src/notifications.ts"
  ]
}
