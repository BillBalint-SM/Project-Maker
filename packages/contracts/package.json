{
  "name": "@project-maker/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/projects.d.ts",
      "default": "./dist/projects.js"
    },
    "./active-project-queue": {
      "types": "./dist/active-project-queue.d.ts",
      "default": "./dist/active-project-queue.js"
    },
    "./project-preparation-status": {
      "types": "./dist/project-preparation-status.d.ts",
      "default": "./dist/project-preparation-status.js"
    },
    "./discovery-follow-ups": {
      "types": "./dist/discovery-follow-ups.d.ts",
      "default": "./dist/discovery-follow-ups.js"
    },
    "./markdown-templates": {
      "types": "./dist/markdown-templates.d.ts",
      "default": "./dist/markdown-templates.js"
    },
    "./customer-mail": {
      "types": "./dist/customer-mail.d.ts",
      "default": "./dist/customer-mail.js"
    },
    "./general-playbook-runtime": {
      "types": "./dist/general-playbook-runtime.d.ts",
      "default": "./dist/general-playbook-runtime.js"
    },
    "./discovery-runtime": {
      "types": "./dist/discovery.d.ts",
      "default": "./dist/discovery.js"
    },
    "./decision-portfolio-runtime": {
      "types": "./dist/decision-portfolio.d.ts",
      "default": "./dist/decision-portfolio.js"
    },
    "./customer-response-runtime": {
      "types": "./dist/customer-response.d.ts",
      "default": "./dist/customer-response.js"
    },
    "./notifications-runtime": {
      "types": "./dist/notifications.d.ts",
      "default": "./dist/notifications.js"
    }
  },
  "files": ["dist", "playbooks"],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
