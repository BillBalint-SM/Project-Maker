{
  "name": "@project-maker/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build && node scripts/copy-general-playbook.mjs",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "migration:run": "typeorm-ts-node-commonjs -d src/database/migration-data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/database/migration-data-source.ts migration:revert",
    "migration:show": "typeorm-ts-node-commonjs -d src/database/migration-data-source.ts migration:show",
    "test": "tsc --project ./test/tsconfig.json && node --test --test-concurrency=1 ./dist-test/test/*.spec.js ./dist-test/test/*e2e-spec.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/typeorm": "11.0.3",
    "@project-maker/contracts": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "imapflow": "1.7.1",
    "nodemailer": "9.0.5",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/mailparser": "3.4.6",
    "@types/node": "26.1.2",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.20.3",
    "@types/smtp-server": "3.5.13",
    "@types/supertest": "7.2.1",
    "mailparser": "3.9.15",
    "selfsigned": "5.5.0",
    "smtp-server": "3.19.3",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
