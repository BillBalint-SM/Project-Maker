  "cards": [
    {
      "dot": "emerald",
      "title": "Canonical records vs. derived views",
      "items": ["Project, Initial Intake, Discovery, and Customer correspondence are persisted; Estimation Readiness, Decision Score, Active Project Queue, and Internal notifications are derived at read time."]
    },
    {
      "dot": "violet",
      "title": "Immutable provenance",
      "items": ["Published Question Bank version / Published playbook version → Project question schema → Initial Intake snapshot → Specification version → editable Delivery package → confirmed Delivery handoff snapshot."]
    },
    {
      "dot": "rose",
      "title": "Shared domain boundaries",
      "items": ["Angular and MCP call the same domain services; Customer communication and Delivery handoff remain explicit, bounded side effects."]
