POSTGRES_DB=project_maker
POSTGRES_USER=project_maker_app
POSTGRES_PASSWORD=replace-with-secret
DATABASE_URL=postgres://project_maker_app:replace-with-secret@postgres:5432/project_maker
WEB_PORT=8080
CORS_ORIGIN=http://localhost:8080
CUSTOMER_RESPONSE_ORIGIN=http://localhost:8080
CUSTOMER_RESPONSE_PREVIEW_SECRET=replace-with-at-least-32-random-characters
GIT_CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
GIT_HANDOFF_PREVIEW_SECRET=replace-with-at-least-32-random-characters
FOLLOW_UP_POLL_INTERVAL_MS=60000
ATTACHMENT_MAX_MIB=50
CORRESPONDENCE_MAILBOX_POLL_INTERVAL_MS=60000
CORRESPONDENCE_MAILBOX_NAME=Project Maker
CORRESPONDENCE_MAILBOX_ADDRESS=project-maker@example.invalid
MAIL_GATEWAY_SMTP_HOST=smtp.example.invalid
MAIL_GATEWAY_SMTP_PORT=587
MAIL_GATEWAY_SMTP_SECURITY=STARTTLS_REQUIRED
MAIL_GATEWAY_SMTP_USERNAME=project-maker-smtp
MAIL_GATEWAY_SMTP_PASSWORD=replace-with-smtp-secret
MAIL_GATEWAY_IMAP_HOST=imap.example.invalid
MAIL_GATEWAY_IMAP_PORT=993
MAIL_GATEWAY_IMAP_SECURITY=IMPLICIT_TLS
MAIL_GATEWAY_IMAP_USERNAME=project-maker-imap
MAIL_GATEWAY_IMAP_PASSWORD=replace-with-imap-secret
MAIL_GATEWAY_IMAP_FOLDER=INBOX
MAIL_GATEWAY_TLS_CA_CERTIFICATE_BASE64=
